{
  "name": "@cdcabrera/eslint-config-toolkit",
  "version": "2.0.0",
  "description": "An ESLint multipurpose config collection.",
  "author": "cdcabrera",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdcabrera/eslint-config-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/cdcabrera/eslint-config-toolkit/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "javascript",
    "nodejs",
    "react",
    "lint",
    "style",
    "code-quality"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./base": "./configs/base.js",
    "./node": "./configs/node.js",
    "./react": "./configs/react.js",
    "./json": "./configs/json.js",
    "./jest": "./configs/jest.js",
    "./vitest": "./configs/vitest.js",
    "./typescript": "./configs/typescript.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "configs/*.js"
  ],
  "scripts": {
    "release": "changelog --link-url https://github.com/cdcabrera/eslint-config-toolkit.git",
    "test": "npm run test:lint && npm run test:spell && npm run test:spell-docs && npm run test:types && npm run test:ci",
    "test:ci": "export CI=true; npm run test:jest -- --collectCoverage --coverageReporters=\"lcov\" --coverageReporters=\"json-summary\"",
    "test:clearCache": "npm run test:jest -- --clearCache",
    "test:configs": "eslint --config ./tests/eslint.config.js './tests/__fixtures__/*.{js,jsx,json,jsonc,ts}'",
    "test:dev": "npm run test:spell && npm run test:spell-docs && npm run test:types && npm run test:jest-watch",
    "test:lint": "eslint ./configs ./tests/*.js ./index.js",
    "test:lint-watch": "nodemon --watch configs --watch tests --watch index.js --ext js,jsx --exec \"npm run test:lint\"",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:jest-update": "npm run test:jest -- -u",
    "test:jest-watch": "npm run test:jest -- --watchAll",
    "test:spell-docs": "cspell ./README.md ./DOCS.md ./guidelines/**/* --config ./cspell.config.json",
    "test:spell": "cspell './configs/**/*.js' './tests/**/*' --exclude './tests/**/*snap' --config ./cspell.config.json",
    "test:types": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@babel/core": "8.1.2",
    "@babel/eslint-parser": "8.1.2",
    "@babel/preset-react": "8.0.1",
    "@eslint-react/eslint-plugin": "5.30.2",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint-plugin-comment-length": "2.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2"
  },
  "devDependencies": {
    "changelog-light": "^3.1.0",
    "cspell": "^10.0.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
